# =========================================================================
# Global options
# =========================================================================
# Setting acme_dns here makes DNS-01 (via Cloudflare) the default challenge
# method for every site below — no per-site `tls` block needed, and no
# inbound port 80/443 access required. This is what lets it work behind
# a VPN with no public inbound access.
{
	email {env.SSL_EMAIL}
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# =========================================================================
# Default / catch-all
#   (mirrors the nginx `server_name _;` block, which fell through to Mealie)
# =========================================================================
glance.bhnord.com {
	reverse_proxy {$MEALIE_HOST}:{$MEALIE_PORT}
}

# =========================================================================
# Mealie
# =========================================================================
{$MEALIE_SUBDOMAIN}.{$PROXY_HOST}, {$MEALIE_SUBDOMAIN}.{$WEB_HOST} {
	reverse_proxy {$MEALIE_HOST}:{$MEALIE_PORT}
}

# =========================================================================
# Actual Budget
# =========================================================================
{$ACTUAL_SUBDOMAIN}.{$PROXY_HOST}, {$ACTUAL_SUBDOMAIN}.{$WEB_HOST} {
	reverse_proxy {$ACTUAL_HOST}:{$ACTUAL_PORT}
}

# =========================================================================
# Paperless-ngx
# =========================================================================
{$PAPERLESS_SUBDOMAIN}.{$PROXY_HOST}, {$PAPERLESS_SUBDOMAIN}.{$WEB_HOST} {
	request_body {
		max_size 20MB
	}
	reverse_proxy {$PAPERLESS_HOST}:{$PAPERLESS_PORT}
}

# =========================================================================
# Glance
# =========================================================================
{$GLANCE_SUBDOMAIN}.{$PROXY_HOST}, {$GLANCE_SUBDOMAIN}.{$WEB_HOST} {
	request_body {
		max_size 20MB
	}
	reverse_proxy {$GLANCE_HOST}:{$GLANCE_PORT}
}

