# =========================================================================
# Chibi
# =========================================================================
{$CHIBI_SUBDOMAIN}.{$PROXY_HOST}, {$CHIBI_SUBDOMAIN}.{$WEB_HOST} {
	request_body {
		max_size 200MB
	}
	reverse_proxy {$CHIBI_HOST}:{$CHIBI_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
}

# =========================================================================
# Tools
# =========================================================================
{$TOOLS_SUBDOMAIN}.{$PROXY_HOST}, {$TOOLS_SUBDOMAIN}.{$WEB_HOST} {
	request_body {
		max_size 200MB
	}
	reverse_proxy {$TOOLS_HOST}:{$TOOLS_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
}

